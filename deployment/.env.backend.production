# ===========================================
# TeacherCalc Backend - Production Environment
# ===========================================
# Copy this file to: /home/ubuntu/TeacherCalc/backend/.env
# Replace YOUR_EC2_IP with your actual EC2 IP (e.g., 54.123.45.67)
# ===========================================

# Django Core Settings
DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_NEW_KEY
ALLOWED_HOSTS=YOUR_EC2_IP

# Database Configuration (PostgreSQL)
DATABASE_NAME=teachercalc
DATABASE_USER=teachercalc_user
DATABASE_PASSWORD=CHANGE_ME_YOUR_DB_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME_YOUR_EMAIL@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_YOUR_APP_PASSWORD
DEFAULT_FROM_EMAIL=TeacherCalc <CHANGE_ME_YOUR_EMAIL@gmail.com>

# CORS & CSRF Configuration (use http:// since no SSL yet)
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_IP

# Frontend URL (for email verification links)
FRONTEND_URL=http://YOUR_EC2_IP
