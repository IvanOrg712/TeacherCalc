# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# For production, copy to .env.production

# ===================
# Django Core Settings
# ===================
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALLOWED_HOSTS=your-ec2-ip-here,your-domain.com

# ===================
# Database Configuration
# ===================
DATABASE_NAME=teachercalc
DATABASE_USER=teachercalc_user
DATABASE_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Alternative: Use DATABASE_URL format (for dev.py)
# DATABASE_URL=postgres://user:password@localhost:5432/teachercalc

# ===================
# Email Configuration (Gmail SMTP)
# ===================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=TeacherCalc <your-email@gmail.com>

# ===================
# CORS & CSRF Configuration
# ===================
CORS_ALLOWED_ORIGINS=http://your-ec2-ip-here,https://your-domain.com
CSRF_TRUSTED_ORIGINS=http://your-ec2-ip-here,https://your-domain.com

# ===================
# Frontend URL (for email verification links)
# ===================
FRONTEND_URL=http://your-ec2-ip-here

# ===================
# Optional Security Settings (for HTTPS deployments)
# ===================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ===================
# Generate SECRET_KEY with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# ===================
