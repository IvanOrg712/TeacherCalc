# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Django Settings
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALLOWED_HOSTS=your-ec2-ip-here,your-domain.com

# Database Configuration
DATABASE_NAME=teachercalc
DATABASE_USER=teachercalc_user
DATABASE_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://your-ec2-ip-here,https://your-domain.com

# Frontend URL (for email verification links)
FRONTEND_URL=http://your-ec2-ip-here

# Generate SECRET_KEY with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
